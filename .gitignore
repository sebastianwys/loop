# zillow research csvs are fetched, not redistributed. the manifest records
# their sha256 and vintage, and the values derived for each metro ship in the map json
data/raw/zillow/*.csv

# every alfred vintage of fhfa's metro index, 140 MB, fetched again by
# scripts/download_fhfa_vintages.py. the manifest records its sha256 and the
# latest release it holds
data/raw/fhfa_vintages/*.csv

# snakemake run metadata and logs
.snakemake/

# a body on its way to an archive, named beside the file it will be renamed
# over, and the directory a collector stages its whole folder in. a run that
# dies cleans both up, a run that is killed cannot
data/raw/*/*.part
data/raw/*/.staging-*/

# the map payload is staged beside metros.json the same way, and both workflows
# commit this folder
web/public/data/*.part

# boundary shapefiles are fetched by npm run boundaries, the topojson is committed
data/raw/boundaries/*.zip
data/raw/boundaries/trial_*.json

# the model page's figures, copied out of ml/results by the web build
web/public/figures/
