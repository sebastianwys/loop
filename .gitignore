# zillow research csvs are fetched, not redistributed. the manifest records
# their sha256 and vintage, and the derived per-metro values ship in the map json
data/raw/zillow/*.csv

# snakemake run metadata and logs
.snakemake/

# the markers the download rules declare in place of the archive itself, so a
# failed rule cannot take the vintage with it
data/raw/*/.download_complete

# boundary shapefiles are fetched by npm run boundaries, the topojson is committed
data/raw/boundaries/*.zip
data/raw/boundaries/trial_*.json

# local handoff notes, never committed
HANDOFF.md

# stack-audit working state. the three exceptions are the ratchet: baseline
# keeps coverage from eroding, false_positives makes the next run quieter
.audit/*
!.audit/config.json
!.audit/baseline.json
!.audit/false_positives.jsonl

# the stack-audit record. kept locally, not published in a portfolio repo
docs/audit-2026-09/

# the model page's figures, copied out of ml/results by the web build
web/public/figures/
